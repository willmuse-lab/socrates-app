# Copy this file to ".env" for local development, and set the same variables
# in Netlify (Site configuration → Environment variables) for production.
# VITE_* variables are read at BUILD time and inlined into the frontend.

# ── Required: the AI analyzer ───────────────────────────────────────────────
# Server-side only (used by the Netlify function). Get one at console.anthropic.com.
ANTHROPIC_API_KEY=

# ── Optional: real accounts, cloud save, and the Research Library ────────────
# Without these two, the app runs in local/demo mode (browser-only, fake admin
# data, no persisted research uploads). With them, accounts and sync are real.
# Find both in your Supabase project: Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Optional: admin area password ───────────────────────────────────────────
# Gates the Admin Dashboard / Research Library. NOTE: this is bundled into the
# frontend and is therefore visible to anyone who inspects the site — treat it
# as a soft gate, not real security. Defaults to "socrates2025" if unset.
VITE_ADMIN_PASSWORD=

# ── Optional: Stripe billing (teacher plan) ─────────────────────────────────
# Leave VITE_BILLING_ENABLED unset and the app behaves exactly as it did before
# Stripe existed: upgrade buttons stay hidden and the wall says "launching soon".
# Set it to true only once the Stripe dashboard is set up (and the Terms are
# reviewed). VITE_ vars bake at BUILD time — redeploy after changing this.
VITE_BILLING_ENABLED=

# Server-side only (Netlify env vars, never VITE_). From dashboard.stripe.com:
#   STRIPE_SECRET_KEY      Developers → API keys → Secret key (sk_test_… / sk_live_…)
#   STRIPE_PRICE_MONTHLY   Product catalogue → your $9.99/mo price → price_…
#   STRIPE_PRICE_ANNUAL    Product catalogue → your $99.99/yr price → price_…
#   STRIPE_WEBHOOK_SECRET  Developers → Webhooks → your endpoint → signing secret (whsec_…)
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_WEBHOOK_SECRET=

# Supabase service-role key (Settings → API → service_role). Used ONLY by the
# Stripe webhook, to flip a teacher's plan after payment. It bypasses row-level
# security — keep it server-side and mark it secret in Netlify. NEVER prefix
# this with VITE_, which would bake it into the public frontend bundle.
SUPABASE_SERVICE_ROLE_KEY=
